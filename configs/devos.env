# ============================================================
# DevOS Central Configuration — configs/devos.env
# ALL build scripts must source this file.
# Never hardcode any of these values in scripts.
# ============================================================

# --- Identity ---
DEVOS_BRAND_NAME="DevOS"
DEVOS_VERSION="1.0"
DEVOS_ARCH="amd64"
DEVOS_ISO_LABEL="DevOS-1.0"

# --- Base Distribution ---
DEVOS_BASE_CODENAME="trixie"
DEVOS_BASE_MIRROR="http://deb.debian.org/debian"
DEVOS_BASE_SECURITY="http://security.debian.org/debian-security"
DEVOS_BASE_VARIANT="minbase"

# --- Kernel ---
DEVOS_KERNEL_PACKAGE="linux-image-amd64"
DEVOS_KERNEL_HEADERS="linux-headers-amd64"

# --- Desktop ---
DEVOS_DESKTOP="gnome"

# --- Repository ---
DEVOS_REPO_CODENAME="trixie"
DEVOS_REPO_COMPONENT="main"
DEVOS_REPO_URL_INTERNAL="file:///srv/devos-repo"
DEVOS_REPO_URL_PUBLIC="https://packages.devos.example"

# --- Build Paths ---
DEVOS_BUILD_ROOT="/build"
DEVOS_ROOTFS_DIR="${DEVOS_BUILD_ROOT}/rootfs/base"
DEVOS_LIVE_ROOTFS_DIR="${DEVOS_BUILD_ROOT}/rootfs/live"
DEVOS_ISO_TREE="${DEVOS_BUILD_ROOT}/iso"
DEVOS_OUTPUT_DIR="${DEVOS_BUILD_ROOT}/output"
DEVOS_SOURCES_DIR="${DEVOS_BUILD_ROOT}/sources"
DEVOS_REPO_DIR="/srv/devos-repo"

# --- Signing (public keys only — never private) ---
DEVOS_KEYRING_FILE="/etc/apt/keyrings/devos-archive-keyring.gpg"
DEVOS_REPO_KEY_ID=""

# --- Toolchain manifests ---
DEVOS_TOOLCHAIN_MANIFEST="${DEVOS_BUILD_ROOT}/toolchain-manifest.txt"
DEVOS_PACKAGE_MANIFEST="${DEVOS_BUILD_ROOT}/package-manifest.txt"
DEVOS_SOURCE_MANIFEST="${DEVOS_BUILD_ROOT}/source-manifest.txt"
DEVOS_BUILD_MANIFEST="${DEVOS_BUILD_ROOT}/build-manifest.txt"

# --- Reproducibility ---
export SOURCE_DATE_EPOCH=$(git -C "$(dirname "$0")/.." log -1 --format=%ct 2>/dev/null || date +%s)
